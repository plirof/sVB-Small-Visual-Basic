سرعة السلحفاة 50
اكتب "أدخل عدد المربعات: "
المربعات = اقرأ عددا
اكتب "أدخل طول المربع: "
الطول = اقرأ عددا
الزاوية = 360 / المربعات

من ن = 1 إلى المربعات
    # رسم مربع
    من م = 1 إلى 4
        حرك السلحفاة الطول
        دور السلحفاة 90
    زد م
    # تغيير زاوية السلحفاة لتدوير المربع القادم
    دور السلحفاة الزاوية
زد ن