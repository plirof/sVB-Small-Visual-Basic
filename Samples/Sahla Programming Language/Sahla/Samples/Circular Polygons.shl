سرعة السلحفاة 50
اكتب "أدخل عدد الأشكال: "
الأشكال = اقرأ عددا
اكتب "أدخل عدد أضلاع الشكل: "
الأضلاع = اقرأ عددا
اكتب "أدخل طول الضلغ: "
الطول = اقرأ عددا

من ن = 1 إلى الأشكال
    # رسم الشكل
    من م = 1 إلى الأضلاع
        حرك السلحفاة الطول
        دور السلحفاة 360 / الأضلاع
    زد م
    # تغيير زاوية السلحفاة لتدوير الشكل القادم
    دور السلحفاة 360 / الأشكال
زد ن